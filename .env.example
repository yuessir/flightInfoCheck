# ZenRows API Key
ZENROWS_API_KEY=your_zenrows_api_key_here

# LINE BOT 廣播接收端點 (本地為 http://localhost:3000/api/preview，正式環境為 Vercel 網址 /api/broadcast)
LINE_BOT_ENDPOINT=https://your-linebot-domain.vercel.app/api/broadcast

# 開發模式開關 (true 時讀取本地 sample，false 時呼叫 ZenRows)
DEV_MODE=false

# Upstash Redis 設定 (用於狀態與變頻時間槽管理)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here
